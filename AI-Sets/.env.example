# Copy this file to .env and edit as needed.
# Every example in this project runs with NONE of these set.
# The defaults below are the "offline, free, deterministic" mode.

# ---- LLM backend ----
# "fake"   -> FakeLLM. No network. No cost. Deterministic. THE DEFAULT.
# "claude" -> real Anthropic API. Needs ANTHROPIC_API_KEY below.
LLM_BACKEND=fake

# Only needed when LLM_BACKEND=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest

# ---- Safety budgets (used by the agent and agentic modules) ----
MAX_AGENT_STEPS=5
MAX_USD_PER_RUN=0.50
MAX_SECONDS_PER_RUN=60

# ---- Logging ----
# "text" for human-readable console logs, "json" for structured logs
LOG_FORMAT=text
LOG_LEVEL=INFO

# ---- Paths (normally leave these alone) ----
DATA_DIR=data
